{
  "description": "Log work hours and wages, track cash advances, and generate proof of income",
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "dashboard.payday",
      "name": "Dashboard reminds you on a client's payday (demo data)",
      "path": "/?demo=1&un-now=2026-10-17T10:00:00Z",
      "expectSelector": "#payday-banner",
      "expectText": "Payday today",
      "visual": true,
      "impact": ["public/app.js", "wagebook.js"]
    },
    {
      "id": "dashboard.demo",
      "name": "Dashboard shows totals, weekly chart and client balances (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#weekly-chart",
      "expectText": "Advance left",
      "visual": true,
      "impact": ["public/app.js", "public/index.html", "styles/**", "wagebook.js"]
    },
    {
      "id": "dashboard.month-total",
      "name": "Dashboard shows this month's total above Recent entries (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#month-total",
      "expectText": "Earned in",
      "visual": true,
      "impact": ["public/app.js", "wagebook.js"]
    },
    {
      "id": "week-recap.demo",
      "name": "Dashboard shows this week by client with Share recap (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#week-recap",
      "expectText": "Share recap",
      "visual": true,
      "impact": ["public/app.js", "wagebook.js"]
    },
    {
      "id": "summary.months",
      "name": "Monthly summary lists each month's hours, days and pay (demo data)",
      "path": "/summary?demo=1",
      "expectSelector": "#months",
      "expectText": "days worked",
      "visual": true,
      "impact": ["public/app.js", "wagebook.js"]
    },
    {
      "name": "Monthly summary with no work offers to start logging",
      "path": "/summary",
      "expectSelector": "#empty-months",
      "expectText": "No work logged yet"
    },
    {
      "name": "Dashboard links to the monthly summary (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#open-summary",
      "expectText": "Monthly summary"
    },
    {
      "name": "Empty book shows a 3-step start guide",
      "path": "/",
      "expectSelector": "#start-steps",
      "expectText": "How to start, in 3 steps"
    },
    {
      "name": "Dashboard with an empty book offers to log the first day",
      "path": "/",
      "expectSelector": "#empty-book",
      "expectText": "Your wage book is empty"
    },
    {
      "name": "Log today's work opens on step 1 with saved clients",
      "path": "/log?demo=1",
      "expectSelector": "[data-client]",
      "expectText": "Step 1 of 3"
    },
    {
      "name": "Take an advance form",
      "path": "/advance?demo=1",
      "expectSelector": "#amount",
      "expectText": "Who gave you the advance?"
    },
    {
      "name": "Take an advance marks a client close to the advance limit (demo data)",
      "path": "/advance?demo=1",
      "expectSelector": "[data-client][data-limit=\"near\"]",
      "expectText": "Who gave you the advance?"
    },
    {
      "name": "Dashboard client rows open the client's settings (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#client-balances a[data-nav^=\"/clients/\"]"
    },
    {
      "name": "Profile form",
      "path": "/profile",
      "expectSelector": "#occupation",
      "expectText": "Your work"
    },
    {
      "name": "Dashboard warns about items below their profit goal (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#price-alerts",
      "expectText": "Prices to check"
    },
    {
      "id": "months.demo",
      "name": "Earnings by month lists each month with days, hours and pay (demo data)",
      "path": "/months?demo=1",
      "expectSelector": "#months [data-month]",
      "expectText": "Earned",
      "visual": true,
      "impact": ["public/app.js", "wagebook.js"]
    },
    {
      "name": "Earnings by month with an empty book says so",
      "path": "/months",
      "expectSelector": "#empty-months",
      "expectText": "No months yet"
    },
    {
      "name": "Dashboard's Earned this month tile opens Earnings by month (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#summary a[data-nav=\"/months\"]",
      "expectText": "See earnings by month"
    },
    {
      "name": "Prices and profit lists items and this week's ranking (demo data)",
      "path": "/prices?demo=1",
      "expectSelector": "#week-summary",
      "expectText": "Least profitable",
      "visual": true,
      "impact": ["public/app.js", "wagebook.js", "styles/**"]
    },
    {
      "name": "Prices and profit with no items offers to add one",
      "path": "/prices",
      "expectSelector": "#empty-prices",
      "expectText": "No items yet"
    },
    {
      "name": "Add an item shows costs and a suggested price",
      "path": "/prices/new",
      "expectSelector": "#cost-rows",
      "expectText": "Suggested price"
    }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "📒"
  }
}
