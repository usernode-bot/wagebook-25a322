{
  "description": "Log work hours and wages, track cash advances, and generate proof of income",
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "dashboard.demo",
      "name": "Dashboard shows totals, weekly chart and client balances (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#weekly-chart",
      "expectText": "Advance left",
      "visual": true,
      "impact": ["public/app.js", "public/index.html", "styles/**", "wagebook.js"]
    },
    {
      "name": "Dashboard with an empty book offers to log the first day",
      "path": "/",
      "expectSelector": "#empty-book",
      "expectText": "Your wage book is empty"
    },
    {
      "name": "Log today's work opens on step 1 with saved clients",
      "path": "/log?demo=1",
      "expectSelector": "[data-client]",
      "expectText": "Step 1 of 3"
    },
    {
      "name": "Take an advance form",
      "path": "/advance?demo=1",
      "expectSelector": "#amount",
      "expectText": "Who gave you the advance?"
    },
    {
      "name": "Profile form",
      "path": "/profile",
      "expectSelector": "#occupation",
      "expectText": "Your work"
    },
    {
      "name": "Dashboard warns about items below their profit goal (demo data)",
      "path": "/?demo=1",
      "expectSelector": "#price-alerts",
      "expectText": "Prices to check"
    },
    {
      "name": "Prices and profit lists items and this week's ranking (demo data)",
      "path": "/prices?demo=1",
      "expectSelector": "#week-summary",
      "expectText": "Least profitable",
      "visual": true,
      "impact": ["public/app.js", "wagebook.js", "styles/**"]
    },
    {
      "name": "Prices and profit with no items offers to add one",
      "path": "/prices",
      "expectSelector": "#empty-prices",
      "expectText": "No items yet"
    },
    {
      "name": "Add an item shows costs and a suggested price",
      "path": "/prices/new",
      "expectSelector": "#cost-rows",
      "expectText": "Suggested price"
    }
  ]
}
